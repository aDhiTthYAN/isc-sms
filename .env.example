# Firebase Cloud Messaging - needed for browser push notifications
# Get server key from: Firebase Console → Project Settings → Cloud Messaging → Server key
VITE_FCM_SERVER_KEY=your_fcm_server_key_here

# Firebase VAPID key for Web Push
# Get from: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Generate key pair
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

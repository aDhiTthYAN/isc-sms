rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isCEO() {
      return isAuth() &&
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'ceo';
    }

    function isCEOorAdmin() {
      return isAuth() && (
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'ceo' ||
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin'
      );
    }

    match /staff/{uid} {
      allow read: if isAuth();
      allow create, delete: if isCEO();
      allow update: if isAuth() && (request.auth.uid == uid || isCEO());
    }

    match /students/{doc} {
      allow read, write: if isAuth();
    }

    match /followups/{doc} {
      allow read, write: if isAuth();
    }

    match /assessments/{doc} {
      allow read, write: if isAuth();
    }

    match /batches/{doc} {
      allow read, write: if isAuth();
    }

    match /schedules/{doc} {
      allow read, write: if isAuth();
    }

    match /batchTasks/{doc} {
      allow read, write: if isAuth();
    }

    match /notifications/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    match /documents/{doc} {
      allow read, write: if isAuth();
    }

    match /tasks/{doc} {
      allow read: if isAuth();
      allow create, delete: if isCEO();
      allow update: if isAuth();
    }

    match /reports/{doc} {
      allow read, write: if isAuth();
    }

    match /concerns/{doc} {
      allow read, write: if isAuth();
    }

    match /leads/{doc} {
      allow read, write: if isAuth();
    }

    match /attendance/{doc} {
      allow read, write: if isAuth();
    }
  }
}

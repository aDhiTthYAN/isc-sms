index 051c9e8..4a7349f 100644
--- a/src/index.css
+++ b/src/index.css
@@ -206,6 +206,15 @@ select.form-input { appearance:none; cursor:pointer; background-image:url("data:
 /* Legacy compat */
 .badge-purple { background:var(--violet-soft); color:var(--violet-ink); }
 
+/* Neutral category chip */
+.chip { display:inline-flex; align-items:center; gap:5px; padding:2px 9px; border-radius:var(--radius-sm); font-size:var(--fs-xs); font-weight:600; background:var(--surface-sunken); color:var(--text-sub); white-space:nowrap; line-height:1.5; }
+
+/* Segmented control (tab pills inside a sunken track) */
+.segmented { display:inline-flex; background:var(--surface-sunken); border-radius:10px; padding:3px; gap:2px; }
+.segmented button { display:flex; align-items:center; gap:6px; padding:7px 14px; border:none; border-radius:8px; font-family:var(--font-body); font-size:12.5px; font-weight:600; cursor:pointer; background:transparent; color:var(--text-muted); transition:background var(--dur) var(--ease), color var(--dur) var(--ease); }
+.segmented button.active { background:var(--surface); color:var(--text); box-shadow:var(--shadow-xs); }
+.segmented button .seg-count { font-size:11px; opacity:.7; }
+
 /* Table */
 .table-container { border-radius:var(--radius-xl); border:1px solid var(--border); background:var(--surface); overflow:hidden; box-shadow:var(--shadow-sm); }
 table { width:100%; border-collapse:collapse; font-size:var(--fs-base); }
